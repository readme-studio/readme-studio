# GitHub OAuth App（在 GitHub Developer Settings 创建）
# Authorization callback URL 填：http://localhost:3000/api/auth/callback/github
# 申请的 scope：read:user public_repo（仅只读，用于读取资料与列出仓库）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth.js 会话加密密钥（任意长随机串，例如 `openssl rand -base64 32`）
AUTH_SECRET=

# 部署后的公网地址（生产环境填写，例如 https://your-domain.vercel.app）
NEXTAUTH_URL=

# 服务端 AI 总结所用模型密钥（不填则回退本地 Ollama，可零费用本地测试）
OPENAI_API_KEY=
# OpenAI 兼容服务的 Base URL（可选，可指向 DeepSeek / SiliconFlow / 智谱 等免费云）
OPENAI_BASE_URL=

# 生产环境按 IP 的每日限额（可选；不填则开发环境直接放行）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
